rules_version = '2'

// PdskWork Firestore security rules.
// Collections: `posts` (blog CMS), `scheduledJobs` (auto-poster), `reports` (analytics), `agentConfigs` (agent settings),
// `autoPilotConfig`, `agentRuns`, `contentPlans`, `distributionJobs`.
//
// - Public users can READ published posts (so the public blog renders without
//   auth).
// - Writes (create/update/delete) require an authenticated Firebase Auth user
//   with a verified email. Optionally lock writes to a single admin uid by
//   setting ADMIN_UID below.
//
// IMPORTANT: Replace the placeholder ADMIN_EMAIL with the email address of the
// real admin after creating the account in the Firebase Console. The default
// allows any verified email for initial setup; restrict it before going public.

const ADMIN_EMAIL = "owner@example.com" // TODO: replace with real admin email
const ADMIN_UID = "" // TODO: replace with real admin uid, or leave empty to allow any verified email

function isAdmin() {
  // Require authenticated + verified email. If ADMIN_UID is set, also match UID.
  return request.auth != null
    && request.auth.token.email_verified == true
    && (ADMIN_UID == "" || request.auth.uid == ADMIN_UID)
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Blog posts. Public read of published posts; admin-only writes.
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin()
      allow create, update, delete: if isAdmin()
    }

    // Auto-post scheduler jobs. Admin-only access.
    match /scheduledJobs/{jobId} {
      allow read, write: if isAdmin()
    }

    // Periodic analytics reports. Admin-only access.
    match /reports/{reportId} {
      allow read, write: if isAdmin()
    }

    // Generated posts (agent draft before approval). Admin-only access.
    match /generatedPosts/{postId} {
      allow read, write: if isAdmin()
    }

    // Agent configuration. Admin-only access.
    match /agentConfigs/{configId} {
      allow read, write: if isAdmin()
    }

    // AutoPilot configuration. Admin-only access.
    match /autoPilotConfig/{configId} {
      allow read, write: if isAdmin()
    }

    // AutoPilot execution runs. Admin-only access.
    match /agentRuns/{runId} {
      allow read, write: if isAdmin()
    }

    // Content plans for AutoPilot. Admin-only access.
    match /contentPlans/{planId} {
      allow read, write: if isAdmin()
    }

    // Distribution jobs. Admin-only access.
    match /distributionJobs/{jobId} {
      allow read, write: if isAdmin()
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false
    }
  }
}
