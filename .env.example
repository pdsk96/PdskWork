# Public, client-safe values only. Real secrets belong in .env.local (gitignored).
NEXT_PUBLIC_APP_NAME=PdskWork
# Canonical site URL — used for sitemap, robots, RSS feed, and OG metadata.
NEXT_PUBLIC_SITE_URL=https://pdsk.qd.je

# Optional: send Web Vitals RUM to an endpoint (leave blank to disable).
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Server-only secrets — set these in production via Cloud Secret Manager, NOT here.
# See FIREBASE.md. Never commit real values.
ADMIN_AUTH_SECRET=
ADMIN_PASSWORD=

# Optional writable directory for the JSON blog store. On serverless runtimes
# (Firebase App Hosting / Cloud Run) the deployed filesystem is read-only, so
# leave unset for read-only seed data, or point this at a writable volume to
# enable admin create/edit/delete. See FIREBASE.md.
BLOG_DATA_DIR=
