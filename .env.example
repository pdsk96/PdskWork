# Public, client-safe values only. Real secrets belong in .env.local (gitignored).
NEXT_PUBLIC_APP_NAME=PdskWork
# Canonical site URL — used for sitemap, robots, RSS feed, and OG metadata.
NEXT_PUBLIC_SITE_URL=https://pdskwork.web.app

# Optional: send Web Vitals RUM to an endpoint (leave blank to disable).
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Firebase config is baked into src/lib/firebase.ts (web config is public by
# design). Admin auth + blog data use Firebase Auth + Firestore (client SDK).
# No server-side secrets are needed for the static export. To enable the CMS,
# create an admin user in the Firebase console (Authentication → Users) and
# import the seed posts — see FIREBASE.md.
